[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]

; universal dylib built by grcc-lib-macosx-universal (lipo of x86_64 + arm64)
macos.debug = "res://gdnative/macosx/universal/libcctoy.dylib"
macos.release = "res://gdnative/macosx/universal/libcctoy.dylib"
windows.debug.x86_64 = "res://gdnative/windows/x86_64-pc-windows-gnullvm/cctoy.dll"
windows.release.x86_64 = "res://gdnative/windows/x86_64-pc-windows-gnullvm/cctoy.dll"
windows.debug.arm64 = "res://gdnative/windows/aarch64-pc-windows-gnullvm/cctoy.dll"
windows.release.arm64 = "res://gdnative/windows/aarch64-pc-windows-gnullvm/cctoy.dll"
linux.debug.x86_64 = "res://gdnative/linux/x86_64-unknown-linux-gnu/libcctoy.so"
linux.release.x86_64 = "res://gdnative/linux/x86_64-unknown-linux-gnu/libcctoy.so"
linux.debug.arm64 = "res://gdnative/linux/aarch64-unknown-linux-gnu/libcctoy.so"
linux.release.arm64 = "res://gdnative/linux/aarch64-unknown-linux-gnu/libcctoy.so"
android.debug.arm64 = "res://gdnative/android/aarch64-linux-android/libcctoy.so"
android.release.arm64 = "res://gdnative/android/aarch64-linux-android/libcctoy.so"
android.debug.x86_64 = "res://gdnative/android/x86_64-linux-android/libcctoy.so"
android.release.x86_64 = "res://gdnative/android/x86_64-linux-android/libcctoy.so"
android.debug.arm32 = "res://gdnative/android/armv7-linux-androideabi/libcctoy.so"
android.release.arm32 = "res://gdnative/android/armv7-linux-androideabi/libcctoy.so"
android.debug.x86_32 = "res://gdnative/android/i686-linux-android/libcctoy.so"
android.release.x86_32 = "res://gdnative/android/i686-linux-android/libcctoy.so"
; Godot picks .threads.wasm when the Web preset has Thread Support enabled
web.debug.threads.wasm32 = "res://gdnative/web/wasm32-unknown-emscripten/cctoy.threads.wasm"
web.release.threads.wasm32 = "res://gdnative/web/wasm32-unknown-emscripten/cctoy.threads.wasm"
web.debug.wasm32 = "res://gdnative/web/wasm32-unknown-emscripten/cctoy.wasm"
web.release.wasm32 = "res://gdnative/web/wasm32-unknown-emscripten/cctoy.wasm"
